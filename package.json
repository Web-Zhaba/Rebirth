{
  "name": "rebirth",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "pace": "vitest run --config vitest.pace.config.ts --reporter=dot",
    "build:yandex": "tsc --noEmit && vite build --mode yandex --outDir dist-yandex && node scripts/pack-yandex.mjs dist-yandex rebirth-yandex.zip"
  },
  "dependencies": {
    "@fontsource/bitter": "^5.3.0",
    "@fontsource/golos-text": "^5.3.0",
    "@fontsource/pt-sans": "^5.3.0",
    "@fontsource/pt-serif": "^5.3.0",
    "@mapbox/vector-tile": "^3.0.0",
    "@preact/signals": "^2.11.3",
    "earcut": "^3.2.4",
    "pbf": "^5.1.2",
    "preact": "^11.0.2"
  },
  "devDependencies": {
    "@iconify-json/game-icons": "^1.2.4",
    "@iconify-json/ph": "^1.2.2",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@types/geojson": "^7946.0.16",
    "@webgpu/types": "^0.1.74",
    "typescript": "^5.0.0",
    "unplugin-icons": "^24.0.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.5"
  }
}
